{
  "root": true,
  "env": {
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "extends": ["eslint:recommended"],
  "ignorePatterns": [
    "node_modules/",
    "client/",
    "app-data/",
    "USERDATA/",
    "data/",
    "dist/",
    "*.log"
  ],
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "no-constant-condition": ["error", { "checkLoops": false }],
    "no-console": "off",
    "no-prototype-builtins": "off"
  },
  "overrides": [
    // Root tooling configs are ESM (`export default`); the backend itself is CommonJS.
    {
      "files": ["vitest.config.js", "*.config.mjs"],
      "parserOptions": { "sourceType": "module" }
    },
    // Playwright `page.evaluate()` callbacks are serialised and executed inside the
    // browser, so they legitimately reference `document` / `window`.
    {
      "files": ["src/services/pageCommenter.js"],
      "env": { "browser": true }
    }
  ]
}
