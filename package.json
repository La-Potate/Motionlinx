{
  "name": "motionlinx-server",
  "version": "0.6.0",
  "description": "Motionlinx — workspace for every growth toolkit (SEO Toolkit, AI Traffic Report, …)",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "cd client && npm run build",
    "install-client": "cd client && npm install",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "generic-pool": "^3.9.0",
    "google-auth-library": "^9.15.1",
    "googleapis": "^144.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^10.3.1",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.45.0",
    "sqlite3": "^5.1.6",
    "stripe": "^12.18.0",
    "undici": "^6.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.2.5",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "seo",
    "local-business",
    "rank-tracker",
    "schema",
    "citations"
  ],
  "author": "SEO Toolkit",
  "license": "MIT"
}
