# =============================================================================
# SEO Toolkit — environment configuration
# Copy this file to `.env` and fill in the values you need.
# =============================================================================

# -----------------------------------------------------------------------------
# Core runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# JWT secret for signing tokens. REQUIRED in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=

# CORS allowed origins (comma-separated). REQUIRED in production to lock CORS down.
# Local dev typically uses http://localhost:3001 (Vite/CRA dev server).
CLIENT_ORIGIN=http://localhost:3001

# -----------------------------------------------------------------------------
# Persistent storage
# -----------------------------------------------------------------------------
# Where the SQLite database and per-user files live.
# Local dev: defaults to `./app-data` relative to server.js if unset.
# Docker:    set to an absolute host path (e.g. D:/SEOToolkit/app-data or /srv/seo-toolkit/data).
USERDATA_PATH=

# -----------------------------------------------------------------------------
# Auth tuning
# -----------------------------------------------------------------------------
MAX_FAILED_LOGINS=6
ACCOUNT_LOCK_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# Bootstrap password for the auto-created `admin` user on a fresh database.
# REQUIRED in production — the server will refuse to auto-create an admin
# without it (you must seed one manually if this is unset in prod).
# In dev: defaults to "admin123" with a stark log warning if unset.
INITIAL_ADMIN_PASSWORD=

# 32 raw bytes (base64) used to AES-256-GCM-encrypt user API keys at rest.
# Without it, keys are stored in plaintext in SQLite and system-settings.json
# (a startup warning fires). Strongly recommended in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=

# -----------------------------------------------------------------------------
# Google OAuth (optional — leave blank to disable Sign in with Google)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# DataForSEO (optional — keyword research, SERP, business info)
# -----------------------------------------------------------------------------
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# -----------------------------------------------------------------------------
# Stripe billing (optional — leave blank to disable billing routes)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
# REQUIRED in production if STRIPE_SECRET_KEY is set — webhooks refuse unsigned requests.
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PERSONAL=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_TOPUP=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# Optional defense-in-depth IP allowlist for the webhook endpoint. Either
# `auto` (uses the bundled snapshot of Stripe's published ranges), or a
# comma-separated CIDR list from https://stripe.com/files/ips/ips_webhooks.json
# Leave blank to disable the IP check (signature verification still runs).
STRIPE_WEBHOOK_IPS=

# -----------------------------------------------------------------------------
# Anthropic Claude (optional — content generation features)
# -----------------------------------------------------------------------------
CLAUDE_API_KEY=

# -----------------------------------------------------------------------------
# Scraping user-agents (optional)
# -----------------------------------------------------------------------------
SCHEMA_AUTOFILL_USER_AGENT=
BUSINESS_AUDIT_USER_AGENT=
