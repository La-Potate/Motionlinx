# Dependencies
node_modules/
client/node_modules/

# Production build
client/build/
client/dist/
dist/

# User data and database
USERDATA/
app-data/
# Anchored to the repo root: this is the legacy runtime data dir migrated by
# app.js. WITHOUT the leading slash it also matched src/data/ and
# client/src/data/, silently excluding committed source (e.g. the citation
# publisher list) and breaking a fresh clone at boot.
/data/
database.sqlite
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Environment variables
.env
.env.local
.env.production
.env.development
# Dotless variants — a file created as `env` instead of `.env` still holds
# real secrets but is NOT matched by the patterns above.
/env
/env.*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Backup folders
OLD-Versions/
backup/
backups/

# Temp files
tmp/
temp/
*.tmp

# Test files
coverage/
.nyc_output/

# Misc
*.bak
*.orig

# HAR files (may contain sensitive session data)
*.har

# Claude Code workspace
.claude/
